// Tests for map.map_keys and map.filter_keys

// map_keys - transform keys to uppercase
{"hello": 1, "world": 2} > map.map_keys((k string) { k > str.upper() }(string)) > map.key_present?("HELLO") > assert(true)
{"hello": 1, "world": 2} > map.map_keys((k string) { k > str.upper() }(string)) > map.key_present?("WORLD") > assert(true)

// map_keys - values preserved
{"a": 42} > map.map_keys((k string) { k > str.upper() }(string)) > get("A") > assert(42)

// map_keys - key collision (later key wins)
{"a": 1, "A": 2} > map.map_keys((k string) { k > str.upper() }(string)) > get("A") > assert(2)

// map_keys - empty map
{} > map.map_keys((k string) { k > str.upper() }(string)) > size() > assert(0)

// filter_keys - keep matching keys
{"name": "Alice", "age": 30, "city": "NYC"} > map.filter_keys((k string) { k > eq?("name") }(bool)) > size() > assert(1)
{"name": "Alice", "age": 30, "city": "NYC"} > map.filter_keys((k string) { k > eq?("name") }(bool)) > get("name") > assert("Alice")

// filter_keys - no matches returns empty map
{"a": 1, "b": 2} > map.filter_keys((k string) { k > eq?("z") }(bool)) > size() > assert(0)

// filter_keys - all match returns same map
{"a": 1, "b": 2} > map.filter_keys((k string) { true }(bool)) > size() > assert(2)

// filter_keys - empty map
{} > map.filter_keys((k string) { true }(bool)) > size() > assert(0)
