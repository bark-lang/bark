// Tests for map.del_path

// nested deletion
{"a": {"b": {"c": 1, "d": 2}}} > map.del_path("a", "b", "c") > get("a", "b") > map.key_absent?("c") > assert(true)
{"a": {"b": {"c": 1, "d": 2}}} > map.del_path("a", "b", "c") > get("a", "b", "d") > assert(2)

// single key - equivalent to map.del
{"a": 1, "b": 2} > map.del_path("a") > size() > assert(1)
{"a": 1, "b": 2} > map.del_path("a") > map.key_absent?("a") > assert(true)

// missing final key is no-op
{"a": {"b": 1}} > map.del_path("a", "missing") > get("a", "b") > assert(1)

// preserves sibling keys
{"a": {"x": 1, "y": 2, "z": 3}} > map.del_path("a", "y") > get("a") > size() > assert(2)
