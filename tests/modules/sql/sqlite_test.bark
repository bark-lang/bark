// Tests for sql module SQLite operations

// Open in-memory database
sql.open("sqlite", ":memory:") > capture(conn_err, conn)
conn_err > absent?() > assert(true)

// Create table
conn > sql.exec("CREATE TABLE test_users (id INTEGER PRIMARY KEY, name TEXT, active INTEGER)") > capture(create_err, _)
create_err > absent?() > assert(true)

// Insert with parameters (SQL injection safe)
conn > sql.exec("INSERT INTO test_users (name, active) VALUES (?, ?)", ["Alice", 1]) > capture(e1, affected1)
e1 > absent?() > assert(true)
affected1 > eq?(1) > assert(true)

conn > sql.exec("INSERT INTO test_users (name, active) VALUES (?, ?)", ["Bob", 0]) > capture(e2, affected2)
e2 > absent?() > assert(true)
affected2 > eq?(1) > assert(true)

// Query all rows
conn > sql.query("SELECT id, name, active FROM test_users ORDER BY id") > capture(q_err, rows)
q_err > absent?() > assert(true)
rows > len() > eq?(2) > assert(true)

// Check first row
rows > get(0) > get("name") > eq?("Alice") > assert(true)
rows > get(0) > get("active") > eq?(1) > assert(true)

// Query with parameters
conn > sql.query("SELECT * FROM test_users WHERE name = ?", ["Bob"]) > capture(bob_err, bob_rows)
bob_err > absent?() > assert(true)
bob_rows > len() > eq?(1) > assert(true)
bob_rows > get(0) > get("active") > eq?(0) > assert(true)

// Update
conn > sql.exec("UPDATE test_users SET active = ? WHERE name = ?", [1, "Bob"]) > capture(upd_err, updated)
upd_err > absent?() > assert(true)
updated > eq?(1) > assert(true)

// Verify update
conn > sql.query("SELECT active FROM test_users WHERE name = ?", ["Bob"]) > capture(v_err, v_rows)
v_err > absent?() > assert(true)
v_rows > get(0) > get("active") > eq?(1) > assert(true)

// Transaction - commit
sql.begin(conn) > capture(tx_err, tx)
tx_err > absent?() > assert(true)

tx > sql.exec("INSERT INTO test_users (name, active) VALUES (?, ?)", ["Charlie", 1]) > capture(charlie_err, _)
charlie_err > absent?() > assert(true)

tx > sql.commit() > capture(commit_err, _)
commit_err > absent?() > assert(true)

// Verify commit persisted
conn > sql.query("SELECT COUNT(*) as cnt FROM test_users") > capture(cnt_err, cnt_rows)
cnt_err > absent?() > assert(true)
cnt_rows > get(0) > get("cnt") > eq?(3) > assert(true)

// Transaction - rollback
sql.begin(conn) > capture(tx2_err, tx2)
tx2_err > absent?() > assert(true)

tx2 > sql.exec("INSERT INTO test_users (name, active) VALUES (?, ?)", ["Dave", 1]) > capture(dave_err, _)
dave_err > absent?() > assert(true)

tx2 > sql.rollback() > capture(rollback_err, _)
rollback_err > absent?() > assert(true)

// Verify rollback - Dave should not exist
conn > sql.query("SELECT COUNT(*) as cnt FROM test_users WHERE name = ?", ["Dave"]) > capture(dave_cnt_err, dave_cnt_rows)
dave_cnt_err > absent?() > assert(true)
dave_cnt_rows > get(0) > get("cnt") > eq?(0) > assert(true)

// Delete
conn > sql.exec("DELETE FROM test_users WHERE name = ?", ["Charlie"]) > capture(del_err, deleted)
del_err > absent?() > assert(true)
deleted > eq?(1) > assert(true)

// Close connection
conn > sql.close() > capture(close_err, _)
close_err > absent?() > assert(true)

// Test invalid driver
sql.open("invalid_driver", "foo") > capture(driver_err, _)
driver_err > present?() > assert(true)
