// Tests for array module operations

// array.push - add to end
[1, 2, 3] > array.push(4) > len() > assert(4)
[1, 2, 3] > array.push(4) > get(3) > assert(4)

// array.push multiple elements
[1, 2, 3] > array.push(4, 5, 6) > len() > assert(6)

// array.append_to - pipe-friendly push (value first, array second)
10 > array.append_to([1, 2, 3]) > len() > assert(4)
10 > array.append_to([1, 2, 3]) > get(3) > assert(10)

// array.unshift - add to beginning
[2, 3, 4] > array.unshift(1) > get(0) > assert(1)
[2, 3, 4] > array.unshift(1) > len() > assert(4)

// array.unshift multiple elements
[4, 5, 6] > array.unshift(1, 2, 3) > len() > assert(6)

// array.pop - remove from end (returns [modified_array, popped_element])
[1, 2, 3, 4, 5] > array.pop() > (result array) {
  result > get(0) > len() > assert(4)
  result > get(1) > assert(5)
}()

// array.shift - remove from beginning
[1, 2, 3, 4, 5] > array.shift() > (result array) {
  result > get(0) > len() > assert(4)
  result > get(1) > assert(1)
}()

// array.slice - extract portion (start, end - exclusive)
[10, 20, 30, 40, 50] > array.slice(1, 4) > len() > assert(3)
[10, 20, 30, 40, 50] > array.slice(1, 4) > get(0) > assert(20)
[10, 20, 30, 40, 50] > array.slice(1, 4) > get(2) > assert(40)

// array.dedupe - remove duplicates
[1, 2, 2, 3, 3, 3, 4] > array.dedupe() > len() > assert(4)
["apple", "banana", "apple", "cherry", "banana"] > array.dedupe() > len() > assert(3)

// array.range - generate sequence (inclusive)
array.range(1, 5) > len() > assert(5)
array.range(1, 5) > get(0) > assert(1)
array.range(1, 5) > get(4) > assert(5)
array.range(-3, 3) > len() > assert(7)
