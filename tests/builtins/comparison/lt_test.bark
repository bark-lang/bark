// Tests for lt?() builtin

// Integer comparisons
5 > lt?(10) > assert(true)
10 > lt?(5) > assert(false)
5 > lt?(5) > assert(false)

// Float comparisons
2.5 > lt?(3.0) > assert(true)
3.14 > lt?(3.14) > assert(false)

// Negative numbers
-5 > lt?(-1) > assert(true)
-1 > lt?(-5) > assert(false)

// Zero comparisons
-1 > lt?(0) > assert(true)
0 > lt?(0) > assert(false)
0 > lt?(1) > assert(true)
