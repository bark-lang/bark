// Tests for div() builtin

// Basic integer division
10 > div(2) > assert(5)

// Division by one
7 > div(1) > assert(7)

// Integer division truncates
7 > div(2) > assert(3)

// Float division preserves decimals
7.0 > div(2.0) > assert(3.5)

// Chained divisions
100 > div(2) > div(5) > assert(10)

// Dividing by negative numbers
12 > div(-3) > assert(-4)

// Negative divided by negative
-12 > div(-4) > assert(3)

// Zero divided by something
0 > div(5) > assert(0)
