// Tests for memoization patterns (mfn keyword)

// Fibonacci - memoized
mfn fib(n int) {
  n > lte?(1) > return?(n)
  n > sub(1) > fib() > a
  n > sub(2) > fib() > b
  a > add(b) > return()
}(int)

0 > fib() > assert(0)
1 > fib() > assert(1)
2 > fib() > assert(1)
3 > fib() > assert(2)
4 > fib() > assert(3)
5 > fib() > assert(5)
6 > fib() > assert(8)
7 > fib() > assert(13)
8 > fib() > assert(21)
10 > fib() > assert(55)
20 > fib() > assert(6765)

// Factorial - memoized
mfn factorial(n int) {
  n > lte?(1) > return?(1)
  n > sub(1) > factorial() > prev
  n > mul(prev) > return()
}(int)

0 > factorial() > assert(1)
1 > factorial() > assert(1)
2 > factorial() > assert(2)
3 > factorial() > assert(6)
4 > factorial() > assert(24)
5 > factorial() > assert(120)
6 > factorial() > assert(720)
10 > factorial() > assert(3628800)

// Ackermann function - memoized
mfn ackermann(m int, n int) {
  m > eq?(0) > (is_zero bool) {
    is_zero > eq?(false) > return?()
    n > add(1) > return()
  }(int) > base_result
  base_result > present?() > return?(base_result)

  n > eq?(0) > (is_n_zero bool) {
    is_n_zero > eq?(false) > return?()
    m > sub(1) > ackermann(1) > return()
  }(int) > zero_result
  zero_result > present?() > return?(zero_result)

  m > sub(1) > m_minus_1
  n > sub(1) > n_minus_1
  m > ackermann(n_minus_1) > inner
  m_minus_1 > ackermann(inner) > return()
}(int)

0 > ackermann(0) > assert(1)
0 > ackermann(5) > assert(6)
1 > ackermann(5) > assert(7)
2 > ackermann(5) > assert(13)
3 > ackermann(5) > assert(253)
