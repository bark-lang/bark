// Tests for Ackermann function

mfn ackermann(m int, n int) {
  m > eq?(0) > is_base
  is_base > (cond bool) {
    cond > eq?(false) > return?()
    n > add(1) > result
    return(result)
  }(int) > base_result
  base_result > present?() > return?(base_result)
  n > eq?(0) > is_n_zero
  is_n_zero > (cond bool) {
    cond > eq?(false) > return?()
    m > sub(1) > m_minus_1
    m_minus_1 > ackermann(1) > result
    return(result)
  }(int) > zero_result
  zero_result > present?() > return?(zero_result)
  m > sub(1) > m_minus_1
  n > sub(1) > n_minus_1
  m > ackermann(n_minus_1) > inner
  m_minus_1 > ackermann(inner) > result
  return(result)
}(int)

// A(0, n) = n + 1
0 > ackermann(0) > assert(1)
0 > ackermann(1) > assert(2)
0 > ackermann(2) > assert(3)
0 > ackermann(3) > assert(4)
0 > ackermann(4) > assert(5)

// A(1, n) = n + 2
1 > ackermann(0) > assert(2)
1 > ackermann(1) > assert(3)
1 > ackermann(2) > assert(4)
1 > ackermann(3) > assert(5)

// A(2, n) = 2n + 3
2 > ackermann(0) > assert(3)
2 > ackermann(1) > assert(5)
2 > ackermann(2) > assert(7)
2 > ackermann(3) > assert(9)

// A(3, n) = 2^(n+3) - 3
3 > ackermann(0) > assert(5)
3 > ackermann(1) > assert(13)
3 > ackermann(2) > assert(29)
3 > ackermann(3) > assert(61)
