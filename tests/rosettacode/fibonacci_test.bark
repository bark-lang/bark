// Tests for fibonacci

fn fibonacci(n int) {
  n > lte?(0) > return?(0)
  n > eq?(1) > return?(1)
  (n, 2, 0, 1) > (target int, i int, prev int, curr int) {
    prev > add(curr) > next_val
    i > gte?(target) > return?(next_val)
    i > add(1) > next_i
    repeat(target, next_i, curr, next_val)
  }(int) > result
  return(result)
}(int)

0 > fibonacci() > assert(0)
1 > fibonacci() > assert(1)
2 > fibonacci() > assert(1)
3 > fibonacci() > assert(2)
4 > fibonacci() > assert(3)
5 > fibonacci() > assert(5)
6 > fibonacci() > assert(8)
7 > fibonacci() > assert(13)
10 > fibonacci() > assert(55)
20 > fibonacci() > assert(6765)
