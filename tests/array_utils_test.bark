// Test: array utility builtins (sum, min, max, flatten, group_by, min_by, max_by)

// --- array.sum ---
[1, 2, 3, 4, 5] > array.sum() > println()
[] > array.sum() > println()
[1.5, 2.5, 3.0] > array.sum() > println()
[1, 2, 3.5] > array.sum() > println()

// --- array.min / array.max ---
[3, 1, 4, 1, 5, 9] > array.min() > println()
[3, 1, 4, 1, 5, 9] > array.max() > println()
[42] > array.min() > println()
[42] > array.max() > println()

// --- array.flatten ---
[[1, 2], [3, 4]] > array.flatten() > println()
[[1, [2, 3]], [4, [5, [6]]]] > array.flatten() > println()
[[1, [2]], [3, [4, [5]]]] > array.flatten(1) > println()
[] > array.flatten() > println()
[1, 2, 3] > array.flatten() > println()

// --- array.group_by ---
[1, 2, 3, 4, 5, 6] > array.group_by((x int) {
  x > math.mod(2) > to_string() > return()
}(string)) > println()

// --- array.min_by / array.max_by ---
[3, -1, 4, -5, 2] > array.min_by((x int) { x > mul(x) > return() }(int)) > println()
[3, -1, 4, -5, 2] > array.max_by((x int) { x > mul(x) > return() }(int)) > println()
