// ne?(value) - Check if two values are not equal
// Returns: boolean

// Integer inequality
5 > ne?(3) > println() // Output: true
5 > ne?(5) > println() // Output: false

// String inequality
"hello" > ne?("world") > println() // Output: true
"hello" > ne?("hello") > println() // Output: false

// Boolean inequality
true > ne?(false) > println() // Output: true
true > ne?(true) > println() // Output: false

// Array inequality
[1, 2, 3] > ne?([1, 2]) > println() // Output: true
[1, 2, 3] > ne?([1, 2, 3]) > println() // Output: false

// Useful for conditional logic
fn validate_name(name string) {
  name > ne?("") > return?("Name is valid")
  return("Name is empty")
}(string)

"Alice" > validate_name() > println() // Output: Name is valid
"" > validate_name() > println() // Output: Name is empty
