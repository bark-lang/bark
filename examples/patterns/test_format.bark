// Example Test Format
//
// This file demonstrates how to write testable examples.
// Each function is followed by test calls with EXPECT comments.
//
// Format:
//   function_call() > result
//   // EXPECT: expected_value
//
// The test runner will:
// 1. Execute the function call
// 2. Compare actual result with expected value
// 3. Report pass/fail

// Example 1: Simple function
fn add_five(n int) {
  n > add(5) > return()
}(int)

// Test cases
10 > add_five() > println()
// EXPECT: 15

20 > add_five() > println()
// EXPECT: 25

// Example 2: Function with multiple operations
fn double_and_add_ten(x int) {
  x > mul(2) > doubled
  doubled > add(10) > return()
}(int)

// Test cases
5 > double_and_add_ten() > println()
// EXPECT: 20

0 > double_and_add_ten() > println()
// EXPECT: 10

// Example 3: String operations (str.upper)
fn shout(word string) {
  word > str.upper() > return()
}(string)

// Test cases
"hello" > shout() > println()
// EXPECT: HELLO

"bark" > shout() > println()
// EXPECT: BARK

// Example 4: Boolean functions
fn is_positive(n int) {
  n > gt?(0) > return()
}(bool)

// Test cases
5 > is_positive() > println()
// EXPECT: true

-3 > is_positive() > println()
// EXPECT: false

0 > is_positive() > println()
// EXPECT: false

// Example 5: Anonymous functions (when control flow builtins implemented)
// NOTE: These will fail until return?() is implemented

