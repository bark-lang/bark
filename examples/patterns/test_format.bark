//   n > (x int) {
//     x > gt?(100) > return?("large")
//     x > gt?(50) > return?("medium")
//     return("small")
//   }(string) > category
//   return(category)
// }(string)

// Test cases (commented out until return?() works)
// 150 > classify_number() > println()
// // EXPECT: large

// 75 > classify_number() > println()
// // EXPECT: medium

// 25 > classify_number() > println()
// // EXPECT: small

// Notes for test runner implementation:
// 1. Parse EXPECT comments to extract expected values
// 2. Execute the line before EXPECT and capture stdout
// 3. Compare actual vs expected (string comparison or type-aware)
// 4. Report: "test.bark:42 - PASS" or "test.bark:42 - FAIL (expected 15, got 10)"
